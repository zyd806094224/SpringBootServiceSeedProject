<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zyd.springbootserviceseedproject.workflow.mapper.WfApprovalProgressInfoMapper">

    <select id="selectByInstanceGroupId" resultType="com.zyd.springbootserviceseedproject.workflow.domain.WfApprovalProgressInfo">
        SELECT *
        FROM wf_approval_progress_info
        WHERE instance_group_id = #{instanceGroupId}
        ORDER BY id DESC
    </select>

    <select id="selectByProcessInstanceId" resultType="com.zyd.springbootserviceseedproject.workflow.domain.WfApprovalProgressInfo">
        SELECT *
        FROM wf_approval_progress_info
        WHERE process_instance_id = #{processInstanceId}
        ORDER BY node_time DESC
    </select>

</mapper>
